{
  "name": "redone-systemcore-blocks-interface",
  "version": "1.0.0",
  "description": "A sample app using Blockly",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:a301": "node scripts/generate-a301-api.mjs",
    "generate:api": "node scripts/generate-api.mjs",
    "smoke": "tsc --ignoreConfig --ignoreDeprecations 6.0 --module CommonJS --target ES2019 --moduleResolution Node --skipLibCheck --esModuleInterop --rootDir . --outDir /tmp/systemcore-blocks-smoke scripts/smoke-blockly.ts && NODE_PATH=$PWD/node_modules node /tmp/systemcore-blocks-smoke/scripts/smoke-blockly.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "blockly"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.2.7",
    "vue-eslint-parser": "^10.4.1",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "@blockly/continuous-toolbox": "^13.1.0",
    "@blockly/field-colour": "^13.1.0",
    "@nuxt/ui": "^4.6.1",
    "blockly": "^13.1.0",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  }
}
